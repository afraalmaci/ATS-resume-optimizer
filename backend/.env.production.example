# Copy to backend/.env.production ON THE SERVER and fill in. Never commit it.
#   cp backend/.env.production.example backend/.env.production
#   chmod 600 backend/.env.production

# The site address (same origin as the API through Caddy).
CORS_ORIGIN=https://ats.example.com

# Google Gemini free tier. Leave empty to use only the rule engine.
# Do not enable billing on the key's Google project.
GEMINI_API_KEY=
# Optional overrides (defaults: gemini-flash-lite-latest, 15000, 200).
GEMINI_MODEL=
LLM_TIMEOUT_MS=
AI_DAILY_LIMIT=
