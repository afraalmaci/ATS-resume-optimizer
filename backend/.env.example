PORT=3001
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=your_database_url_here

# Google Gemini (free tier). Leave empty to use only the rule engine.
# Get a key at https://aistudio.google.com. Do not enable billing on its project.
# Never commit the real key: it belongs in .env (gitignored) or the host's settings.
GEMINI_API_KEY=
# Optional. Defaults to gemini-flash-lite-latest.
GEMINI_MODEL=
# Optional. AI request timeout in milliseconds. Defaults to 15000.
LLM_TIMEOUT_MS=
# Optional. Max AI calls per day for the whole server; after that the rule
# engine is used. Keeps the free quota safe. Defaults to 200.
AI_DAILY_LIMIT=

# Number of reverse proxies in front of the app, so rate limits see the real
# client IP. Leave empty locally; usually 1 on a hosting platform. Never "true".
TRUST_PROXY=
