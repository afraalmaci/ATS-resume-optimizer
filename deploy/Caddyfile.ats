# Site block for ATS/OPT, imported by the basketwise Caddyfile (see
# docs/DEPLOY.md). The address comes from ATS_SITE_ADDRESS in basketwise's
# .env, e.g. ats.example.com; its DNS A/AAAA records must point to the server.
# Caddy gets the HTTPS certificate itself.
#
# The default keeps the config valid if ATS_SITE_ADDRESS is ever missing:
# otherwise Caddy would refuse to start and take basketwise down with it.
# "ats.localhost" is unreachable from the internet and needs no certificate.
{$ATS_SITE_ADDRESS:http://ats.localhost} {
	encode zstd gzip

	# Uploads are at most 5 MB (checked again by the backend).
	request_body {
		max_size 6MB
	}

	# /api/... goes to the backend without the /api prefix.
	handle_path /api/* {
		reverse_proxy ats-backend:3001
	}

	handle {
		reverse_proxy ats-frontend:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}
